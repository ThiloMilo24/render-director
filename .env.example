# Kopieren nach `.env` (oder `install.cmd` ausführen, das fragt die Keys ab).
# `.env` ist via .gitignore ausgeschlossen.
#
# Keys LEER lassen: der Installer behandelt nicht-leere Werte als
# "schon gesetzt" und überspringt die Abfrage.

# --- Provider ---------------------------------------------------------------
# Anthropic: Director, Validator, Advisor, Standortanalyse
ANTHROPIC_API_KEY=
# Google AI Studio: Bildgenerierung Gemini (NB1 / NB2)
GOOGLE_API_KEY=
# OpenAI: Bildgenerierung und Inpainting (gpt-image-1). Optional, nur nötig,
# wenn im UI das GPT-Backend gewählt wird.
OPENAI_API_KEY=

# --- Prompts ----------------------------------------------------------------
# Regionaler Default-Kontext der Director-Prompts (Vegetation, Berge, Licht),
# wenn eine Scene keinen Standort angibt. Leer = "Alpenraum".
RENDER_DEFAULT_REGION=

# --- Öffentliche Geo-APIs (OSM Overpass, Wikimedia, Wikidata) --------------
# Deren Nutzungsregeln verlangen einen User-Agent mit Kontakt.
RENDER_HTTP_CONTACT=

# --- Demo ohne API-Keys ------------------------------------------------------
# 1 = Mock-Provider statt Anthropic/Google/OpenAI (statische Antworten,
# Ergebnisbild mit "MOCK"-Stempel). Siehe src/render_director/mock_providers.py.
RENDER_MOCK_PROVIDERS=

# --- Pfade (optional) -------------------------------------------------------
# Nur setzen, wenn vom Default abgewichen werden soll. Nicht leer eintragen:
# ein leerer Pfad würde als aktuelles Verzeichnis gelesen.
# RENDER_SNAPSHOT_ROOT=./data/scenes
# RENDER_GENERATIONS_ROOT=./data/generations
# RENDER_PHASE_LABEL=runs
# RENDER_REFERENCE_LIBRARY_ROOT=./data/reference_library
# RENDER_ADHOC_ROOT=./data/adhoc
